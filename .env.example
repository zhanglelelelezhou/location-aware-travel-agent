APP_ENV=development
LOG_LEVEL=INFO
AGENT_PROVIDER=mock
# Set AGENT_PROVIDER=open-meteo to use live geocoding and current weather.
# Other tools remain mocked in this hybrid mode.
WEATHER_TIMEOUT_SECONDS=8
# Set AGENT_PROVIDER=open-data to additionally use OpenStreetMap Overpass for POI.
POI_TIMEOUT_SECONDS=12
# Set AGENT_PROVIDER=mcp to make the LangGraph agent call weather and POI over MCP.
# Without MCP_SERVER_URL, a bundled stdio server is started automatically.
# MCP_SERVER_PROVIDER=mock keeps this path fully offline; open-data uses live adapters.
MCP_SERVER_PROVIDER=open-data
# MCP_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_TIMEOUT_SECONDS=20
# Optional local dense/hybrid retrieval. Install with: pip install -e ".[rag]"
KNOWLEDGE_RETRIEVAL=bm25
KNOWLEDGE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
KNOWLEDGE_DENSE_MIN_SCORE=0.60
# Optional process-local session memory. Requests without session_id stay stateless.
SESSION_MAX_SESSIONS=1000
SESSION_TTL_SECONDS=1800
PENDING_ACTION_TTL_SECONDS=900
AGENT_PLANNER=rule
# Any provider exposing an OpenAI-compatible /chat/completions endpoint can be used.
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=
# LLM_MODEL=
# Set false only when a compatible provider rejects response_format=json_object.
LLM_JSON_MODE=true
LLM_THINKING_MODE=disabled
LLM_MAX_TOKENS=1500
# Optional pricing, used only for local evaluation reports.
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
